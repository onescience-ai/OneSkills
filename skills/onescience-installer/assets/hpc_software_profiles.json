    "description": "高性能分子动力学模拟软件，广泛应用于材料科学、物理学、化学和工程等领域。能够模拟和研究原子、分子、颗粒、连续体和粗粒化体系的动力学行为。",
    "domain": "matchem",
    "download": {
      "url": "https://download.sourcefind.cn:65024/file/9/LAMMPS/DTK-26.04/LAMMPS-stable2Aug2023.dtk2604-17Apr2026.tar.gz",
      "method": "wget",
      "flags": "--content-disposition",
      "archive_type": "tar.gz"
    },
    "install": {
      "default_install_dir": "~/hpc_software/lammps",
      "extract_command": "tar -xzf {archive_file} -C {install_dir} --strip-components=1",
      "binary_subdir": "bin",
      "library_subdir": "lib64"
    },
    "runtime": {
      "required_modules": [
        "compiler/dtk/25.04"
      ],
      "optional_modules": [
        "mpi/hpcx/2.4.1/gcc-7.3.1",
        "mathlib/fftw/3.3.8/double/gnu"
      ],
      "environment_vars": {
        "PATH": "{install_dir}/bin",
        "LD_LIBRARY_PATH": "{install_dir}/lib64"
      }
    },
    "verify": {
      "command": "lmp_mpi -h",
      "pass_criteria": "输出包含 LAMMPS 命令行帮助信息"
    },
    "test_example": {
      "description": "使用 GPU 加速包（-sf gpu -pk gpu）运行 in.lj 算例",
      "commands": [
        "mpirun -np 4 lmp_mpi -sf gpu -pk gpu 1 -in in.lj"
      ]
    },
    "lifecycle_status": "stable"
  }
]
